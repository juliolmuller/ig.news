{
  "name": "ignews",
  "version": "auto",
  "private": true,
  "license": "MIT",
  "author": "Julio L. Muller",
  "homepage": "https://jlm-ignews.vercel.app/",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('.env') || require('fs').copyFileSync('.env.example', '.env')\"",
    "prepare": "husky || true",
    "commit": "commit",
    "release": "semantic-release",
    "dev": "next dev --port 8080",
    "development": "bun run dev",
    "build": "next build",
    "prod": "next start",
    "production": "bun run prod",
    "webhooks": "./stripe listen --forward-to localhost:8080/api/webhooks",
    "lint": "eslint --fix src/ tests/ eslint.config.mjs jest.config.ts next.config.ts",
    "test": "jest"
  },
  "dependencies": {
    "@prismicio/client": "^6.9.0",
    "@prismicio/helpers": "^2.3.9",
    "@prismicio/types": "^0.2.9",
    "@stripe/stripe-js": "^7.10.0",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@jest/types": "^30.5.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.5",
    "eslint-config-any": "^2.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  }
}
